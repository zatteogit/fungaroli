                "source": "commons-desc-page"
              },
              "Credit": {
                "value": "<a href=\"//commons.wikimedia.org/wiki/Giacomo_Bresadola\" class=\"mw-redirect\" title=\"Giacomo Bresadola\">Giacomo Bresadola</a>: „Iconographia Mycologica, vol. VII, Editura Società Botanica Italiana, Milano 1928, tab. 315",
