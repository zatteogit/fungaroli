    },
    {
      "id": "citazione-pascoli-sole",
      "type": "citazione",
      "text": "C’è qualcosa di nuovo oggi nel sole,",
      "author": "Giovanni Pascoli",
      "rights": "pubblico-dominio",
      "status": "published",
      "language": "it",
