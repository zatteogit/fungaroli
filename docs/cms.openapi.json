        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/cms/v1/audit": {
      "get": {
        "summary": "Log delle operazioni; amministratore",
        "responses": {
          "200": {
            "description": "Operazione completata"
          },
          "401": {
            "description": "Identità non autenticata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permesso mancante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "412": {
            "description": "Revisione o release cambiata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Documento non valido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/content/v1/snapshot": {
      "get": {
        "summary": "Snapshot pubblico dello schema 1",
        "responses": {
          "200": {
            "description": "Contenuti pubblicati, release e revisioni",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "304": {
            "description": "Release invariata"
          },
          "503": {
            "description": "Servizio non disponibile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cmsBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "cms_<64 hex characters>"
      },
      "cmsSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-fungaroli_session",
        "description": "Sessione della passkey. Le mutazioni del browser richiedono l’origine autorizzata."
      }
    },
    "schemas": {
      "Document": {
        "type": "object",
        "required": [
          "id",
          "version",
          "publishedVersion",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "publishedVersion": {
            "type": "integer"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "updatedAt": {
            "type": "integer"
          },
          "updatedBy": {
            "type": "string"
          },
          "needsReview": {
            "type": "boolean"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "schemaVersion",
          "release",
          "resources",
          "versions"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "release": {
            "type": "string"
          },
          "resources": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "versions": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
