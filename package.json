{
  "name": "fungaroli",
  "private": true,
  "type": "module",
  "description": "Uscite nei boschi del Lazio, funghi, sentieri e taccuino",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test tests/*.test.mjs",
    "build:artifact": "node tools/build_artifact.mjs",
    "build:vendor": "node tools/build_vendor.mjs",
    "prepare": "npm run build",
    "deploy": "npm test && wrangler deploy",
    "test:browser": "playwright test",
    "build": "npm run build:typescript && npm run build:vendor && npm run design:build",
    "build:typescript": "node tools/build-typescript.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.contracts.json && tsc --project tsconfig.core.json --noEmit",
    "check:typescript": "node tools/build-typescript.mjs --check",
    "pretest": "npm run check:typescript && npm run check:foundation",
    "prestart": "npm run build:typescript",
    "check:architecture": "node tools/foundation/architecture.mjs",
    "check:environments": "node tools/foundation/environments.mjs check",
    "design:build": "node tools/foundation/design-system.mjs",
    "design:check": "node tools/foundation/design-system.mjs --check && node tools/ds-guard.mjs",
    "build:core": "node tools/foundation/build-core.mjs",
    "check:foundation": "npm run check:architecture && npm run check:environments && npm run design:check",
    "env:prepare": "node tools/foundation/environments.mjs prepare",
    "env:dry-run": "node tools/foundation/environments.mjs dry-run",
    "dev:local": "node tools/foundation/environments.mjs dev local",
    "dev:staging": "node tools/foundation/environments.mjs dev staging",
    "dev:demo": "node tools/foundation/environments.mjs dev demo"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.27.3",
    "jsonc-parser": "3.3.1",
    "leaflet": "1.9.4",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "sanitize-html": "2.17.0"
  }
}
