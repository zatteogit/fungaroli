{
  // Cloudflare Workers con file statici: https://developers.cloudflare.com/workers/static-assets/
  // Ambienti (docs/ambienti-ed-edizioni.md): la configurazione principale è la PRODUZIONE,
  // pubblicata dal ramo main. "staging" è un Worker separato con database propri:
  // mai i database di produzione fuori da qui.
  "name": "fungaroli",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // EDITION sceglie la configurazione in editions/<id>.json; ENVIRONMENT compare in testata fuori dalla produzione.
  "vars": { "APP_ORIGIN": "https://fungaroli.zatteo.workers.dev", "CMS_ADMIN_IDS": "2ce3edfd-514c-4ef7-a8f3-9140396360c5", "CMS_EDITOR_IDS": "", "EDITION": "fronda", "ENVIRONMENT": "production" },
  "d1_databases": [
    { "binding": "COMMUNITY_DB", "database_name": "fungaroli-community-eu", "migrations_dir": "migrations" },
    { "binding": "CMS_DB", "database_name": "fungaroli-content", "migrations_dir": "migrations" }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "triggers": { "crons": ["* * * * *", "17 3 * * *", "*/5 4,5 * * *"] },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/redazione", "/redazione/", "/edition.json"]
  },
  // Diario sincronizzato: namespace KV "fungaroli-diario". Il segreto DIARIO_TOKEN
  // sta nelle impostazioni del Worker (Settings -> Variables and Secrets), non qui.
  "kv_namespaces": [
    { "binding": "DIARIO", "id": "d09f741e0e9d47d38d28c69d43efcc3e" }
  ],
  "env": {
    // Worker "fungaroli-staging": prova delle PR prima del merge su main (ramo "staging").
    // Variabili, database, KV e cron non si ereditano: vanno ripetuti qui.
    "staging": {
      "vars": { "APP_ORIGIN": "https://fungaroli-staging.zatteo.workers.dev", "CMS_ADMIN_IDS": "", "CMS_EDITOR_IDS": "", "EDITION": "fronda", "ENVIRONMENT": "staging" },
      "d1_databases": [
        { "binding": "COMMUNITY_DB", "database_name": "fungaroli-staging-community", "database_id": "00969971-e203-40aa-92ea-c0e305c9fa89", "migrations_dir": "migrations" },
        { "binding": "CMS_DB", "database_name": "fungaroli-staging-content", "database_id": "e9f389e8-17d2-4738-a3da-272c43ef3154", "migrations_dir": "migrations" }
      ],
      // Il Worker riconosce i cron dalla stringa esatta. Piano Workers Free: massimo 5 cron
      // per account, 3 sono della produzione. Qui meteo e pulizie; niente archivio delle
      // previsioni, che serve solo alla ricerca in produzione.
      "triggers": { "crons": ["* * * * *", "17 3 * * *"] },
      "preview_urls": false,
      "kv_namespaces": [
        { "binding": "DIARIO", "id": "43cc727eb9d44f809ed8c0a0789651ef" }
      ]
    }
  }
}
